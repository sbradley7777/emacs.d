# List of all the files that will be ignored by git.
# Byte-compiled
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv
.venv

# Folder view configuration files.
.DS*
Desktop.ini

# Thumbnail cache files and backup files.
._*
.*~
Thumbs.db

# Files that might appear on external disks.
.Spotlight-V100
.Trashes

# Patch/diff artifacts.
*.patch
*.diff
*.orig
*.rej

# Emacs artifacts.
*~
\#*\#
*.elc

# Configuration files and caches.
.mypy_cache/
.ruff_cache/
.pytype/
monkeytype.sqlite3
.coverage/
.vscode/
.claude/
