#===============================================================================
# Security - Credentials & Secrets (CRITICAL - always include)
#===============================================================================
# Credential files
secrets/
.authinfo
.netrc
.authinfo.gpg
.password-store/
# SSL/TLS certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx
# SSH private keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
# Environment files (may contain API keys)
.env
.env.local
.env.*.local
*.secret
# Backup directories (may contain secrets from edited files)
backups/
auto-saves/
auto-save-list/

